[Unit]
Description=Rental House Management Flask App (Gunicorn)
# If MySQL runs on this same VPS, this makes systemd start it first and
# restart this service if MySQL restarts. Drop the mysql.service bits if
# you're pointing MYSQL_HOST at a remote/managed database instead.
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/calacihouse
# www-data's default home (/var/www) isn't writable by www-data itself,
# which makes gunicorn fail to write its internal state dir — point HOME
# at the app directory (already chowned to www-data) instead.
Environment=HOME=/opt/calacihouse
EnvironmentFile=/opt/calacihouse/.env
ExecStart=/opt/calacihouse/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile /var/log/rental-house/access.log \
    --error-logfile /var/log/rental-house/error.log \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
